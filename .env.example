# Access Control
ALLOWED_JIDS=
ALLOWED_JIDS_NAMES=
ADMIN_JIDS=
COUNTRY_CODE=91

# Database
# Local:  postgres://iny:iny@localhost:5432/inydb
# Docker: postgres://iny:iny@db:5432/inydb
DATABASE_URL=postgres://iny:iny@localhost:5432/inydb

# LLM (OpenAI-compatible)
AI_API_KEY=
AI_MODEL=openrouter/free
AI_BASE_URL=https://openrouter.ai/api/v1
AI_SITE_URL=
AI_SITE_NAME=

# Embeddings (OpenAI)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# RAG Settings
SIMILARITY_THRESHOLD=0.35
TOP_K=5
MAX_CONTEXT_TOKENS=2000

# Web UI
WEB_PORT=8264

# Docker registry image (used by docker-compose)
# INY_IMAGE=ghcr.io/<user>/iny:<tag>
