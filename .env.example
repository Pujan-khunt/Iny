# ==============================================================================
# Iny Environment Configuration
# Copy this file to .env and configure your values:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Required Settings
# ------------------------------------------------------------------------------

# Your DeepSeek API key (obtain from https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# System prompt defining the assistant personality, persona, and core instructions
SYSTEM_PROMPT="You are Iny, a helpful, friendly, and concise assistant. You have access to tools to answer user questions accurately."

# ------------------------------------------------------------------------------
# Optional Settings & Runtime Overrides
# ------------------------------------------------------------------------------

# Base URL for the DeepSeek API (defaults to https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model identifier (defaults to deepseek-flash)
# DEEPSEEK_MODEL=deepseek-flash

# Logging verbosity: debug | info | warn | error | fatal (defaults to info)
# LOG_LEVEL=info

# Maximum consecutive tool loop iterations before circuit breaker triggers (1-20, defaults to 5)
# MAX_TOOL_ITERATIONS=5

# Maximum historical dialogue turns retained in conversation memory (1-100, defaults to 10)
# MAX_HISTORY_TURNS=10
