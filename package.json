{
	"name": "iny",
	"version": "1.0.0",
	"description": "",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src tests scripts",
		"lint:fix": "eslint src tests scripts --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"deadcode": "knip",
		"check:all": "npm run format:check && npm run lint && npm run deadcode && npm run typecheck && npm test",
		"dev": "tsx --env-file=.env src/index.ts | pino-pretty",
		"start": "node --enable-source-maps --env-file=.env dist/index.js",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:check": "drizzle-kit check",
		"ingest": "tsx --env-file=.env scripts/ingest-announcements.ts",
		"mess:reset": "tsx --env-file=.env scripts/reset-mess.ts"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^26.5.1",
		"@types/pg": "^8.23.1",
		"@vitest/coverage-v8": "^5.0.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "^9.39.5",
		"eslint-plugin-import": "^2.32.0",
		"knip": "^6.42.1",
		"pg": "^8.23.0",
		"pg-mem": "^3.0.14",
		"pino-pretty": "^13.1.3",
		"prettier": "^3.9.10",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"@hapi/boom": "^10.0.1",
		"@whiskeysockets/baileys": "^7.0.0-rc14",
		"drizzle-orm": "^0.45.3",
		"openai": "^7.15.0",
		"pino": "^10.3.1",
		"postgres": "^3.4.9",
		"zod": "^4.6.5"
	},
	"overrides": {
		"whatsapp-rust-bridge": "0.5.5"
	}
}
