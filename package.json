{
  "name": "iny",
  "version": "1.0.0",
  "description": "WhatsApp RAG Chatbot for Scaler School of Technology",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/src/index.js",
    "dev": "tsx --env-file=.env src/index.ts | pino-pretty",
    "chat": "LOG_FILE=logs/chat.log tsx --env-file=.env scripts/chat.ts",
    "web": "tsx --env-file=.env src/web/server.ts | pino-pretty",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "ingest": "tsx --env-file=.env scripts/ingest-docs.ts",
    "logs:cli": "tail -f logs/chat.log | pino-pretty"
  },
  "keywords": [],
  "author": "Pujan Khunt",
  "license": "ISC",
  "dependencies": {
    "@cacheable/node-cache": "^3.1.1",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "drizzle-orm": "^0.45.2",
    "glob": "^13.0.6",
    "js-tiktoken": "^1.0.21",
    "openai": "^7.5.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode-terminal": "^0.12.2",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
